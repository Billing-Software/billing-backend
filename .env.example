# BillCom backend — copy to .env (never commit .env). All secrets via environment in production.
# PowerShell: Copy-Item .env.example .env
# Bash: cp .env.example .env

# --- Core ---
ASPNETCORE_ENVIRONMENT=Development
# SQL Server (local dev only). Production: Key Vault / container secret.
ConnectionStrings__DefaultConnection=Server=localhost;Database=BillCom_DB;Trusted_Connection=True;TrustServerCertificate=True;
# JWT: min 32 random bytes. Generate: openssl rand -base64 48
Jwt__Key=REPLACE_WITH_MIN_32_RANDOM_BYTES_BASE64
Jwt__Issuer=SmartBillingBackend
Jwt__Audience=SmartBillingFrontend
# AES 32-byte base64 key for TokenEncryptionService. Generate: openssl rand -base64 32
Security__TokenEncryptionKey=REPLACE_WITH_32_BYTE_BASE64_KEY

# --- CORS (comma-separated, no wildcards with credentials) ---
Cors__AllowedOrigins=http://localhost:3000,http://localhost:5173

# --- Payments (Razorpay) ---
# Test keys for staging, live keys only in production. Never expose secrets to frontend.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_the_dashboard_webhook_secret

# --- Storage (Cloudflare R2; empty = local wwwroot/uploads fallback) ---
CloudflareR2__AccountId=
CloudflareR2__AccessKey=
CloudflareR2__SecretKey=
CloudflareR2__BucketName=
CloudflareR2__PublicUrl=

# --- Email (SMTP; empty = log-only, no crash) ---
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=BillCom

# --- SMS (Exotel; empty = disabled) ---
Exotel__ApiKey=
Exotel__ApiToken=
Exotel__AccountSid=
Exotel__BaseUrl=https://api.in.exotel.com

# --- Oracle wallet (mount read-only at runtime, never bake into image) ---
TNS_ADMIN=/app/wallet
