## Ignore Visual Studio Temporary Files and Build Results
# User-specific files
*.rsuser
*.suo
*.user
*.userprev
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
*.pidb
*.resources
*.mdb
*.association
*.msym

# Virtual Server paths
_ReSharper*/
*.[ReSharper].user
*.DotSettings.user

# dotnet cli
.dotnet/
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCop.Cache

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vsscc
*.webinfo
*.xml
*.licx
*.cert
*.map

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/
# Uncomment if you have tasks that create to-do lists in editor
# .todo

# MSTest test Results
[Tt]est[Rr]esults/
[Cc]overage/

# Modern C++ template compilation cache
ipch/

# Git diagnostic files
.gitattributes

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.sbdf
*.rds.subproject

# Output of dotnet publish
publish/

# Rider
.idea/
*.sln.iml

# OS metadata
.DS_Store
Thumbs.db

# Oracle Wallet directories & archives (root + project-level)
wallet/
BillingBackend/wallet/
**/wallet/
Wallet_*.zip
*.zip

# Environment secrets
.env
.env.*
.env.local
!.env.example

# Publish profiles / deploy credentials — never commit
*.publishSettings
*.pubxml
*.pubxml.user

